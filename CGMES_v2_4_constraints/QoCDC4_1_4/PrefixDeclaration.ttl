        sh:prefix "prov" ;
    ] ;
    sh:declare [
        a sh:PrefixDeclaration ;
        sh:namespace "http://www.w3.org/ns/adms#"^^xsd:anyURI ;
        sh:prefix "adms" ;
    ] .
