@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix eqco:    <http://entsoe.eu/CIM/EquipmentCoreOperation/3/1/Constraints#> .

main:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:ts:iec:61970-600-2:ed-1" , <http://www.w3.org/ns/shacl#> ;
        dcterms:creator           "ENTSO-E CIM EG"@en  ;
        dcterms:description       "Validation configuration for the CGMES 2.4 Equipment (EQ) Core and Operation profile, including the file header constraints."@en ;
        dcterms:identifier        "urn:uuid:2d64d5a3-7fb6-47de-8256-9b1d0a088e83" ;
        dcterms:issued            "2026-09-24T13:10:44Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:license           "https://www.apache.org/licenses/LICENSE-2.0" ;
        dcterms:modified          "2026-09-24"^^xsd:date ;
        dcterms:publisher         "ENTSO-E"@en ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "ENTSO-E"@en ;
        dcterms:title             "EQ Core Operation CGMES 2.4 validation configuration"@en ;
        owl:versionIRI        <http://iec.ch/TC57/ns/CIM/CGMES/Constraints/main/2.4> ;
        owl:versionInfo       "1.0.0"@en ;
        dcat:theme            "constraints"@en .

main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//SWE_BusinessConstraints//PrefixDeclaration.ttl> .
main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//SWE_BusinessConstraints//ClassCount.ttl> .
main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//CGMES24//EquipmentCoreOperationProfile.ttl> .
main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//CGMES24//ENTSO-E_AP//FileHeaderProfile.ttl> .

eqco:ConductingEquipment.BaseVoltage-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .
eqco:SubGeographicalRegion.Region-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .
eqco:Terminal.ConnectivityNode-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .
eqco:TransformerEnd.BaseVoltage-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .
eqco:VoltageLevel.BaseVoltage-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .
eqco:Terminal.RegulatingControl-cardinality
        rdf:type        sh:PropertyShape;
        sh:deactivated  true .

#Deactivate the ClassCount constraint that is delivered inside the imported constraint files;
#it is replaced by the one imported from ClassCount.ttl.
<https://common-constraints.eu/ClassCount-property>
        a               sh:PropertyShape ;
        sh:deactivated  true .
