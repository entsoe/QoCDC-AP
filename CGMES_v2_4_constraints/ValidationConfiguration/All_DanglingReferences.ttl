@base            <https://coreso.eu/swe/rosc/constraints/ncp/configuration/2.2> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix main:    <https://coreso.eu/swe/rosc/constraints/ncp/configuration/2.2#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix cim:     <http://iec.ch/TC57/CIM100#> .

main:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:ts:iec:61970-600-2:ed-1" , <http://www.w3.org/ns/shacl#> ;
        dcterms:creator           "Coreso SWE CCR"@en ;
        dcterms:description       "Validation configuration for the SWE custom dangling reference check across the assembled CGMES 2.4 and NCP 2.2 datasets (multiple datasets)."@en ;
        dcterms:identifier        "urn:uuid:e69abc95-695f-40c1-814d-88296aeb92c5" ;
        dcterms:issued            "2026-09-24T13:10:44Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:license           "https://www.apache.org/licenses/LICENSE-2.0" ;
        dcterms:modified          "2026-09-24"^^xsd:date ;
        dcterms:publisher         "Coreso SWE CCR"@en ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "Coreso SWE CCR"@en ;
        dcterms:title             "Dangling references SWE custom validation configuration"@en ;
        owl:versionIRI        <https://coreso.eu/swe/rosc/constraints/ncp/configuration/2.2> ;
        owl:versionInfo       "1.0.0"@en ;
        dcat:theme            "constraints"@en .

main:   owl:imports  <https://raw.githubusercontent.com/entsoe/qocdc-ap/main/CGMES_v2_4_constraints/QoCDC4_1_4/PrefixDeclaration.ttl> .

main:DanglingReferences
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
		sh:prefixes cim: ;
        sh:select """
            SELECT DISTINCT ?this
            WHERE {
                ?subject ?predicate ?this .

                FILTER(?predicate != rdf:type)
                FILTER(isIRI(?this))

                FILTER(
                    STRSTARTS(STR(?this), "urn:uuid:")
                    || CONTAINS(STR(?this), "#_")
                    || STRENDS(STR(?this), "#")
                )

                FILTER NOT EXISTS {
                    ?this rdf:type ?type .
                }
            }
        """ ;
    ] ;

    sh:property main:All-DanglingReferences .

main:All-DanglingReferences
    a sh:PropertyShape ;
    sh:path rdf:type ;
    sh:minCount 1 ;
	sh:order        10;
	sh:name         "DanglingReference";
	sh:severity     sh:Violation;
	sh:group        main:DanglingReferences;
	sh:description  "For all references (part of the CGMES profiles and additional, if existing), the mRID specified in every rdf:resource in the assembly of cimxml instance files shall be defined in an existing rdf:ID and rdf:about part of the data exchange.";
    sh:message   "Dangling reference found." .
