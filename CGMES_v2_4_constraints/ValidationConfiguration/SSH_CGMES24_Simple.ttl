main:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:ts:iec:61970-600-2:ed-1" , <http://www.w3.org/ns/shacl#> ;
        dcterms:creator           "ENTSO-E CIM EG"@en  ;
        dcterms:description       "Validation configuration for the CGMES 2.4 Steady State Hypothesis (SSH) profile, including the file header constraints."@en ;
