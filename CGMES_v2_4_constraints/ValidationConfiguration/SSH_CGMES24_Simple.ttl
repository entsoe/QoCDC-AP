main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//SWE_BusinessConstraints//PrefixDeclaration.ttl> .
main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//SWE_BusinessConstraints//ClassCount.ttl> .
main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//CGMES24//ENTSO-E_AP//FileHeaderProfile.ttl> .
main:   owl:imports  <C://SHACL-Constraints//Coreso_SWE//CGMES24//ENTSO-E_AP//SteadyStateHypothesisProfile.ttl> .

#Deactivate the ClassCount constraint that is delivered inside the imported constraint files;
#it is replaced by the one imported from ClassCount.ttl.
<https://common-constraints.eu/ClassCount-property>
        a               sh:PropertyShape ;
        sh:deactivated  true .