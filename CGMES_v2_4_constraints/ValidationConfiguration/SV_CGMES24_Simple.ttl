main:Ontology  rdf:type         owl:Ontology ;
        dcterms:conformsTo        "urn:iso:ts:iec:61970-600-2:ed-1" , <http://www.w3.org/ns/shacl#> ;
        dcterms:creator           "ENTSO-E CIM EG"@en  ;
        dcterms:description       "Validation configuration for the CGMES 2.4 State Variables (SV) profile, including the file header constraints."@en ;
        dcterms:identifier        "urn:uuid:06cb694e-02fb-4a88-b4f2-06093b1ae8f4" ;
        dcterms:issued            "2026-09-24T13:10:44Z"^^xsd:dateTime ;
        dcterms:language          "en-GB" ;
        dcterms:license           "https://www.apache.org/licenses/LICENSE-2.0" ;
        dcterms:modified          "2026-09-24"^^xsd:date ;
        dcterms:publisher         "ENTSO-E"@en  ;
        dcterms:rights            "Copyright"@en ;
        dcterms:rightsHolder      "ENTSO-E"@en  ;
        dcterms:title             "SV CGMES 2.4 validation configuration"@en ;
        owl:versionIRI        <http://iec.ch/TC57/ns/CIM/CGMES/Constraints/main/2.4> ;
        owl:versionInfo       "1.0.0"@en ;
        dcat:theme            "constraints"@en .

main:   owl:imports  <https://raw.githubusercontent.com/entsoe/qocdc-ap/main/CGMES_v2_4_constraints/QoCDC4_1_4/PrefixDeclaration.ttl> .
main:   owl:imports  <https://raw.githubusercontent.com/entsoe/qocdc-ap/main/CGMES_v2_4_constraints/QoCDC4_1_4/ClassCount.ttl> .
main:   owl:imports  <https://raw.githubusercontent.com/entsoe/qocdc-ap/main/CGMES_v2_4_constraints/EnhancedAppLibRDFS24/FileHeaderProfile.ttl> .
main:   owl:imports  <https://raw.githubusercontent.com/entsoe/qocdc-ap/main/CGMES_v2_4_constraints/EnhancedAppLibRDFS24/StateVariablesProfile.ttl> .
main:   owl:imports  <https://raw.githubusercontent.com/entsoe/qocdc-ap/main/CGMES_v2_4_constraints/QoCDC4_1_4/Level2_Header.ttl> .
main:   owl:imports  <https://raw.githubusercontent.com/entsoe/qocdc-ap/main/CGMES_v2_4_constraints/QoCDC4_1_4/Level2_IGMCGM_Single.ttl> .

sv:SvPowerFlow.Terminal-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .	
sv:SvVoltage.TopologicalNode-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .	
sv:TopologicalIsland.AngleRefTopologicalNode-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .	
sv:TopologicalIsland.TopologicalNodes-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .

sv:SvInjection.TopologicalNode-valueType
        a               sh:PropertyShape ;
        sh:deactivated  true .

#Deactivate the ClassCount constraint that is delivered inside the imported constraint files;
#it is replaced by the one imported from ClassCount.ttl.
<https://common-constraints.eu/ClassCount-property>
        a               sh:PropertyShape ;
        sh:deactivated  true .